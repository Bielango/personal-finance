# Copie este arquivo para .env e ajuste os valores

# Chave usada para assinar os tokens JWT (troque por um texto longo e aleatório)
JWT_SECRET=troque-por-uma-chave-longa-e-segura

# Tempo de validade do token (ex.: 8h, 1d)
JWT_EXPIRES_IN=8h

# Arquivo do banco SQLite (criado na raiz do projeto)
DATABASE_FILE=personal-finance.db

PORT=3000
