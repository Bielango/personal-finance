# Copie este arquivo para .env e ajuste os valores

# Banco SQLite local (o arquivo é criado dentro da pasta prisma/)
DATABASE_URL="file:./dev.db"

# Segredo usado para assinar os tokens JWT (troque por um texto longo e aleatório)
JWT_SECRET="troque-este-segredo"

# Tempo de validade do token
JWT_EXPIRES_IN="1d"

PORT=3333
